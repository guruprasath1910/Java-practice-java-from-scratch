class Animal{
    void sound(){
        System.out.println("Animals make a sound");
    }
}
class Dog extends Animal{
    @Override
    void sound(){
        System.out.println("The dog barks.");
    }
}
class Cat extends Animal{
    @Override
            void sound(){
        System.out.println("The cat meows");
    }
}

public class Main{
    public static void main(String[] args){
        Animal a;
        a = new Dog();
        a.sound();

        a = new Cat();
        a.sound();
    }
}
