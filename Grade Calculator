public class Main {
    public static void main(String[] args) {
        int score = 85;

        // if-else chain
        String grade;
        if (score >= 90)      grade = "A";
        else if (score >= 80) grade = "B";
        else if (score >= 70) grade = "C";
        else if (score >= 60) grade = "D";
        else                  grade = "F";
        System.out.println("Score: " + score + ", Grade: " + grade); // Grade: B

        // switch expression (Java 14+)
        String gradeSwitch = switch (score / 10) {
            case 10, 9 -> "A";
            case 8     -> "B";
            case 7     -> "C";
            case 6     -> "D";
            default    -> "F";
        };
        System.out.println("Switch grade: " + gradeSwitch); // B
    }
}
